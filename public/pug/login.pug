doctype html
html(lang='en')
  head
    include partials/head
    style.
      .login-well {
        max-width: 340px;
        margin: 8vh auto 0 auto;
        padding: 24px 28px 28px 28px;
      }
      .login-title {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
      }
  body
    .container
      .well.login-well
        .login-title
          svg.fa-icon(role='presentation' viewbox='0 0 1920 1792' style='fill: #0275D8')
            path(d='M1280 864q0-14-9-23l-352-352q-9-9-23-9t-23 9l-351 351q-10 12-10 24 0 14 9 23t23 9h224v352q0 13 9.5 22.5t22.5 9.5h192q13 0 22.5-9.5t9.5-22.5v-352h224q13 0 22.5-9.5t9.5-22.5zM1920 1152q0 159-112.5 271.5t-271.5 112.5h-1088q-185 0-316.5-131.5t-131.5-316.5q0-130 70-240t188-165q-2-30-2-43 0-212 150-362t362-150q156 0 285.5 87t188.5 231q71-62 166-62 106 0 181 75t75 181q0 76-41 138 130 31 213.5 135.5t83.5 238.5z')
          |  Cloudrive Login
        form(onsubmit='return doLogin()')
          .form-group
            label(for='name') User
            input#name.form-control(type='text', name='name', autocomplete='username', autofocus='', required='')
          .form-group
            label(for='password') Password
            input#password.form-control(type='password', name='password', autocomplete='current-password', required='')
          p.text-danger(v-if='false') &nbsp;
          p#login-error.text-danger(style='display:none')
            strong Access denied!
          button.btn.btn-primary.btn-block(type='submit')
            i.fa.fa-fw.fa-sign-in
            |  Sign in
    include partials/footer
    script.
      function doLogin() {
        var name = document.getElementById('name').value;
        var password = document.getElementById('password').value;
        var err = document.getElementById('login-error');
        err.style.display = 'none';
        var next = '#{next}';
        var xhr = new XMLHttpRequest();
        xhr.open('POST', 'login');
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onload = function() {
          if (xhr.status === 200) {
            window.location.href = (next && next.charAt(0) === '/' && next.charAt(1) !== '/') ? next : '#{uploadAppPath}';
          } else {
            err.style.display = 'block';
          }
        };
        xhr.onerror = function() { err.style.display = 'block'; };
        xhr.send(JSON.stringify({ name: name, password: password }));
        return false;
      }